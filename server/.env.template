#HOST=my.domain.se # Hostname is required for production builds. Defaults to localhost.
PORT=3010 # Port for the server
BASE_PATH=""
SWAGGER_URL_SUFFIX="swagger"
NODE_ENV="development" # Node environment, choose from development, production
DATABASE='mongodb://{usr}:{pwd}@{url}/origoadmin' # Database connection string

UPLOAD_FOLDER='C:\\uploads' # Folder for uploaded files, so for example will be src/uploads
UPLOAD_URL="http://{url}/uploads" # URL for uploaded files, used when retrieving list of files from the api
UPLOAD_MAX_FILESIZE=100000000 # Maximum allowed file size of files uploaded through the POST /media/upload API endpoint
MAPINSTANCE_ROUTE_PATH='http://{url}/api/mapinstances' # URL for the mapinstances api, used as the first part of the publishedUrl property when retrieving list of mapinstances from the api. Should point to the public /proxy path if GIS_PROXY_ENABLED is true.
USE_AZURE_STORAGE=false # Use Azure storage for uploaded files
TOKEN_SECRET='{token_secret}' # Secret for the JWT token, Generate this with npm run generate-secret-key in the server folder
AUTH_ENABLED=false
GIS_PROXY_ENABLED=false # Set to true when serving published maps through the GIS proxy/gateway routes below (id/layer_id resolution is then left to the proxy's JSON filtering instead of being resolved here).

SECURE_FAVOURITES=false # Set to true to require authentication for access to the favourites API endpoint.

# --- GIS proxy / gateway (formerly the standalone `proxy/` service, now built into this server) ---
PROXY_BASE_PATH=/proxy # Base path the GIS proxy routes (auth, gis passthrough, mapinstance JSON delivery, health, refresh-cache) are mounted under.
RESTRICT_LAYERS=true # If true, published map layers are filtered to only those the requesting user has permission for.
RESTRICT_MAPCONTROLS=false # If true, map controls will be restricted to the ones the requesting user has permission for.
REWRITE_SOURCES=true # If true, layer source URLs are rewritten to point at this server's `/proxy/gis/*` passthrough instead of the real source URL.
CORS_ORIGIN="" # Allowed origin for the GIS proxy's cookie-based auth endpoints (must be a specific origin, not a wildcard, for credentialed requests).
WELL_KNOWN="" # OIDC well-known endpoint for the identity provider used by the GIS proxy's login flow.
TOKEN_URL="" # OIDC token endpoint for the identity provider.
CLIENT_ID="" # OIDC client id.
CLIENT_SECRET="" # OIDC client secret.
SCOPE="" # OIDC scope, e.g. "openid groups".
TIMEOUT=10000 # Timeout (ms) for outgoing HTTP requests made by the GIS proxy (OIDC discovery/userinfo, external GIS sources).
SET_ACCESS_TOKEN_COOKIE=true # If true, the GIS proxy sets the OIDC access token in a cookie after login.
AUTH_CLIENT_DOMAIN="" # Domain to set the OIDC auth cookies on.
DISPLAY_NAME="" # Claim to use as the display name returned from the token exchange endpoint.
REDIRECT_URI="" # OIDC client redirect uri, also used for CORS.
PROTECTED_IDP_CLAIM_ROLES="groups" # Claim read from the access token (if JWT) or userinfo response that contains the user's roles/groups.
PROTECTED_IDP_CLAIM_USERNAME="" # Claim read from the access token (if JWT) or userinfo response that contains the username. Falls back to `sub`, then `email`.
AUDIENCE="" # Expected `aud` claim when verifying JWT access tokens (e.g. Entra ID). Falls back to CLIENT_ID if unset.